{
  "compilerOptions": {
    "target": "ES2023",
    // 只能是 bundler，不能是 nodenext：cordis 的 .d.ts 在 nodenext 下解析不了
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  // 只列入口文件，其余文件经 import 带进来
  "include": ["src/index.ts"]
}
