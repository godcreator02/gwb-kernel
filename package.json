{
  "name": "gwb-kernel",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @godcreator02/gwb-kernel-desktop start",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail typecheck",
    "lint": "oxlint . --type-aware --deny-warnings",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "doc": "pnpm --filter gwb-kernel-docs-site exec livedoc check",
    "doc:confirm": "pnpm --filter gwb-kernel-docs-site exec livedoc confirm"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
