{
  "name": "@godcreator/gwb-kernel-desktop",
  "version": "0.8.0",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "description": "gwb 内核：提供主进程插件启动基础能力与页面模块解析环境；包根导出插件与页面的接口类型",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-kernel.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.api.json && node -e \"const fs=require('fs');for(const f of ['index.html','preload.cjs'])fs.copyFileSync('src/'+f,'dist/'+f)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "start": "pnpm build && electron ."
  },
  "engines": {
    "electron": "^44.1.1"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "electron": "44.1.1",
    "typescript": "^7.0.2"
  }
}
