{
  "name": "@godcreator/gwb-kernel-desktop",
  "productName": "gwb-kernel",
  "version": "0.4.1",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./react": "./dist/react/react.js",
    "./react-jsx-runtime": "./dist/react/react-jsx-runtime.js",
    "./react-dom": "./dist/react/react-dom.js",
    "./react-dom-client": "./dist/react/react-dom-client.js",
    "./package.json": "./package.json"
  },
  "description": "gwb 内核：cordis 运行在 Electron 主进程里，整个应用只有主进程与渲染进程。只做第一个插件运行之前必须完成的事",
  "files": [
    "dist"
  ],
  "//gwb": "shared 是内核给页面 importmap 的 react 四个包名，内核自己先收；插件声明同名的一律忽略",
  "gwb": {
    "shared": {
      "react": "./react",
      "react/jsx-runtime": "./react-jsx-runtime",
      "react-dom": "./react-dom",
      "react-dom/client": "./react-dom-client"
    }
  },
  "scripts": {
    "//setup-electron": "postinstall 已拆（0.2.1）：作为依赖装进消费方时它找不到本仓的 electron，必炸。electron 包不带 postinstall，仓内 clone 后跑一次 setup:electron 装二进制",
    "setup:electron": "node node_modules/electron/install.js",
    "build": "pnpm --filter @godcreator/gwb-plugin-api build && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');for(const f of ['index.html','preload.cjs'])fs.copyFileSync('src/'+f,'dist/'+f)\" && node scripts/build-react.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "start": "pnpm build && electron ."
  },
  "engines": {
    "electron": "^44.1.1"
  },
  "//peerDependencies": "cordis 由 home 根上的那一份满足，内核与插件解析到同一份；判据见文档站",
  "peerDependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cordis": "4.0.0-rc.10",
    "electron": "44.1.1",
    "esbuild": "^0.27.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  }
}
