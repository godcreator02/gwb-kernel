{
  "name": "@godcreator/gwb-kernel-desktop",
  "version": "0.7.2",
  "author": {
    "name": "godcreator"
  },
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "description": "gwb 内核：cordis 运行在 Electron 主进程里，整个应用只有主进程与渲染进程。只做第一个插件运行之前必须完成的事；包根导出内核给插件与页面的接口类型",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.api.json && node -e \"const fs=require('fs');for(const f of ['index.html','preload.cjs'])fs.copyFileSync('src/'+f,'dist/'+f)\" && node scripts/build-react.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "start": "pnpm build && electron ."
  },
  "engines": {
    "electron": "^44.1.1"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cordis": "4.0.0-rc.10",
    "electron": "44.1.1",
    "esbuild": "^0.27.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  }
}
