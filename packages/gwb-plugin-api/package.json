{
  "name": "@godcreator/gwb-plugin-api",
  "version": "0.3.0",
  "author": {
    "name": "godcreator"
  },
  "description": "词汇表包（内核契约）：gwbKernel 四个方法（dataDir / version / emit / setShell）与页面上的 window.gwb 的类型；对插件只增不减。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "//dependencies": "运行时依赖一条都不能有。cordis 走 peer——它出现在导出的类型里。判据见文档站",
  "peerDependencies": {
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-kernel.git"
  },
  "keywords": [
    "gwb"
  ]
}
