{
  "name": "@godcreator02/gwb-plugin-api",
  "version": "0.0.2",
  "description": "gwb-kernel 的词汇表：插件说话用的那几个名词，只命名不做事",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "//dependencies": "运行时依赖一条都不能有。cordis 走 peer——它出现在导出的类型里。判据见文档站",
  "peerDependencies": {
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  }
}
