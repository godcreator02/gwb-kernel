{
  "name": "@godcreator02/gwb-plugin-api",
  "version": "0.1.1",
  "description": "gwb 内核的词汇表：件说话用的那几个名词，只命名不做事。0.1 起对应单进程内核：appVersion 没了，setShell 进来了",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "//dependencies": "运行时依赖一条都不能有。cordis 走 peer——它出现在导出的类型里。判据见文档站",
  "peerDependencies": {
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  }
}
